# Copy this file to .env and fill in your real values
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=Cluster0
MONGO_DB=contacts_db
MONGO_COLLECTION=contacts

OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenRouter replaces OpenAI for chat completions when this key is set.
# Embeddings still use OPENAI_API_KEY (OpenRouter has no embeddings endpoint).
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free
OPENROUTER_REASONING=true

# Set to true only if you created an Atlas Vector Search index named "vector_index"
# on the "embedding" field. If false/unset, the app falls back to in-memory
# cosine similarity search (fine for small/medium collections).
USE_ATLAS_VECTOR_SEARCH=false

# true = RAG mode (query MongoDB via tools). false/unset = fetch ALL contacts
# from CONTACTS_API_URL and send them straight to the LLM.
RAG=false
# Separate backend that serves the contacts data (NOT this app).
CONTACTS_API_URL=http://localhost:8000/api/contacts

# MudraID agent credentials — used to sign outgoing calls to CONTACTS_API_URL.
# The SDK auto-resolves the platform from the agent's grants in the portal,
# so only the two credentials are required (see https://docs.mudraid.ai/guides/get-started/quickstart-agent).
MUDRAID_API_KEY_ID=muid_kid_...
MUDRAID_SECRET=muid_sk_...
MUDRAID_BASE_URL=https://api.staging.mudraid.ai

# This app runs on port 7000.
APP_HOST=127.0.0.1
APP_PORT=8001
